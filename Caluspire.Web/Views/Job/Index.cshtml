@model IEnumerable<Caluspire.Web.Models.JobApplicationViewModel>

<h2>List of Job Applications</h2>

<table>
    <thead>
        <tr>
            <th>Job Title</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in Model)
        {
            <tr>
                <td>@job.JobTitle</td>
                <td><a href="@Url.Action("SubmitApplication", "Job", new { jobId = job.JobId })">Apply</a></td>
            </tr>
        }
    </tbody>
</table>
